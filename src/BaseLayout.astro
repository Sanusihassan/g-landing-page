---
const { pathname } = Astro.url;
const { headProps, faqSchema, websiteSchema } = Astro.props;
let lang = "en";
let dir = "ltr";
let locale;

switch (lang) {
  case "ar":
    break;
  case "es":
    break;
  case "fr":
    break;
  case "hi":
    break;
  case "zh":
    break;
  default:
    break;
}

// Determine language and direction based on URL path
if (pathname.startsWith("/ar")) {
  lang = "ar";
  dir = "rtl";
  locale = "ar_AR";
} else if (pathname.startsWith("/es")) {
  lang = "es";
  locale = "es_ES";
} else if (pathname.startsWith("/fr")) {
  lang = "fr";
  locale = "fr_FR";
} else if (pathname.startsWith("/hi")) {
  lang = "hi";
  locale = "hi_IN";
} else if (pathname.startsWith("/zh")) {
  lang = "zh";
  locale = "zh_CN";
}
import type { faqType } from "./content/content";
import AstroSeo from "./partials/AstroSeo.astro";
import FaveIcons from "./partials/FaveIcons.astro";
import TawkTo from "./partials/TawkTo.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (faqSchema as faqType).questions.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Saira+Semi+Condensed:wght@100;200;300;400;500;600;700;800;900&family=Unna:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#27ae60" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/icons/logo.svg" />
    <slot name="head" />
    <AstroSeo {...headProps} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema)}
    />

    <FaveIcons />
  </head>
  <body>
    <main>
      <slot />
      <TawkTo />
    </main>
  </body>
</html>
