---
const { pathname } = Astro.url;
const { title, description, seoTitle, to } = Astro.props;
let lang = "en";
let dir = "ltr";
let locale;

switch (lang) {
  case "ar":
    break;
  case "es":
    break;
  case "fr":
    break;
  case "hi":
    break;
  case "zh":
    break;
  default:
    break;
}

// Determine language and direction based on URL path
if (pathname.startsWith("/ar")) {
  lang = "ar";
  dir = "rtl";
  locale = "ar_AR";
} else if (pathname.startsWith("/es")) {
  lang = "es";
  locale = "es_ES";
} else if (pathname.startsWith("/fr")) {
  lang = "fr";
  locale = "fr_FR";
} else if (pathname.startsWith("/hi")) {
  lang = "hi";
  locale = "hi_IN";
} else if (pathname.startsWith("/zh")) {
  lang = "zh";
  locale = "zh_CN";
}
const seoConfig = {
  title: seoTitle,
  description: description,
  canonical: `https://www.globasig.com/${to}`,
  openGraph: {
    url: `https://www.globasig.com/${to}`,
    title: seoTitle,
    description: description,
    images: [
      {
        url: `https://www.globasig.com/images/${to}.png`,
        width: 1200,
        height: 630,
        alt: title,
        type: "image/png",
      },
    ],
    site_name: "GlobaSig",
    locale: locale || "en_US",
  },
  twitter: {
    handle: "@globasig",
    site: "@globasig",
    cardType: "summary_large_image",
  },
};

import { AstroSeo } from "@astrolib/seo";
import FaveIcons from "./partials/FaveIcons.astro";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <AstroSeo {...seoConfig} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Saira+Semi+Condensed:wght@100;200;300;400;500;600;700;800;900&family=Unna:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#27ae60" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/icons/logo.svg" />
    <slot name="head" />
    <FaveIcons />
  </head>
  <body>
    <main>
      <!-- <Navbar client:load lang={lang} path={to} /> -->
      <slot />
      <!-- <Footer client:load title={title} lang={lang} /> -->
    </main>
  </body>
</html>
