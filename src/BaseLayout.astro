---
export interface Props {
  headProps: seoConfigType;
  faqSchema: faqType;
  websiteSchema: websiteSchemaType;
  lang: langType;
}
const { headProps, faqSchema, websiteSchema, lang } = Astro.props;
// Determine language direction based on lang
let dir = "ltr";
switch (lang) {
  case "ar":
    dir = "rtl";
    break;
  default:
    dir = "ltr";
}

import Navbar from "globacheap-navbar/src/components/NavBar";
import type {
  faqType,
  seoConfigType,
  websiteSchemaType,
} from "./content/content";
import AstroSeo from "./partials/AstroSeo.astro";
import FaveIcons from "./partials/FaveIcons.astro";
import TawkTo from "./partials/TawkTo.astro";
import { Footer } from "globacheap-footer/src/Footer";

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (faqSchema as faqType).questions.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
import "globacheap-navbar/dist/assets/_page_.css";
import "globacheap-footer/dist/assets/index.css";
import GTag from "./partials/GTag.astro";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <GTag />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Saira+Semi+Condensed:wght@100;200;300;400;500;600;700;800;900&family=Unna:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#27ae60" />
    <slot name="head" />
    <AstroSeo {...headProps} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema)}
    />

    <FaveIcons />
  </head>
  <body>
    <main>
      <Navbar client:load lang={lang === "en" ? undefined : lang} />
      <slot />
    </main>
    <Footer client:load currentLang={lang} title={headProps.footerTitle} />
    <TawkTo />
  </body>
</html>
